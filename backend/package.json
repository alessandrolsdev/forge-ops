{
  "name": "@forgeops/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../scripts/run-bin.mjs tsc --project tsconfig.build.json",
    "dev": "node ../scripts/run-bin.mjs tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "node ../scripts/run-bin.mjs eslint .",
    "typecheck": "node ../scripts/run-bin.mjs tsc --project tsconfig.json --noEmit",
    "test": "node ../scripts/run-bin.mjs vitest run",
    "prisma:generate": "node ../scripts/run-bin.mjs prisma generate",
    "prisma:validate": "node ../scripts/run-bin.mjs prisma validate"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@forgeops/eslint-config": "workspace:*",
    "@forgeops/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
