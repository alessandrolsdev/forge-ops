{
  "name": "@forgeops/cli",
  "version": "0.1.0",
  "description": "CLI do ForgeOps: health score local, dashboard e bootstrap de automacoes (testes + review por @forgeops review).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "forgeops": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "forgeops",
    "cli",
    "automation-health",
    "code-review",
    "github-actions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alessandrolsdev/forge-ops.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/alessandrolsdev/forge-ops/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/alessandrolsdev/forge-ops/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/run-bin.mjs tsc --project tsconfig.build.json",
    "dev": "node ../../scripts/run-bin.mjs tsc --project tsconfig.build.json --watch",
    "lint": "node ../../scripts/run-bin.mjs eslint .",
    "typecheck": "node ../../scripts/run-bin.mjs tsc --project tsconfig.json --noEmit",
    "test": "node ../../scripts/run-bin.mjs vitest run --coverage",
    "prepublishOnly": "node ../../scripts/run-bin.mjs tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@forgeops/core": "workspace:^"
  },
  "devDependencies": {
    "@forgeops/eslint-config": "workspace:*",
    "@forgeops/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
